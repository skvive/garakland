# Generate strong random secret values before deploying.
GARAK_ADMIN_TOKEN=replace_with_secure_random_40_plus_characters
GARAK_QR_SECRET=replace_with_independent_secure_random_40_plus_characters

# Neon Postgres (production) — omit for local SQLite.
# For pg8000 prefer Neon's DIRECT (not -pooler) endpoint.
# If DATABASE_URL is a Neon -pooler URL, db_adapter strips -pooler
# only for its pg8000 connections to avoid prepared statement failures.
# This uses one direct connection per request; monitor Neon max_connections.
DATABASE_URL=
# Optional explicit direct endpoint (takes precedence for pg8000 only).
# Store in Vercel encrypted env, never commit a real URL or password.
GARAK_DB_DIRECT_URL=

# v7 safe GitHub integration
GARAK_V7_MODE=demo
# Optional public HTTPS domain for coupon landing page; NEVER localhost or HTTP
GARAK_PUBLIC_BASE_URL=
GARAK_V5_OPT_OUT_SIGNING_KEY=
GARAK_ENABLE_DEMO=1
GARAK_V5_LIVE_MARKETING=0

# Neon Auth (public URL also in auth/config.public.json)
NEON_AUTH_URL=https://ep-calm-night-b56yzjut.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
