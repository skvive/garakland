# Generate strong random secret values before deploying.
GARAK_ADMIN_TOKEN=replace_with_secure_random_40_plus_characters
GARAK_QR_SECRET=replace_with_independent_secure_random_40_plus_characters

# Neon Postgres (production) — omit for local SQLite
DATABASE_URL=

# v7 safe GitHub integration
GARAK_V7_MODE=demo
# Optional public HTTPS domain for coupon landing page; NEVER localhost or HTTP
GARAK_PUBLIC_BASE_URL=
GARAK_V5_OPT_OUT_SIGNING_KEY=
GARAK_ENABLE_DEMO=1
GARAK_V5_LIVE_MARKETING=0
